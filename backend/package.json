{
  "name": "@treetino/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun run --parallel dev:compile dev:serve",
    "dev:compile": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:serve": "bun --watch dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test test"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@treetino/contracts": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
