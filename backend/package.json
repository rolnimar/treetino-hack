{
  "name": "@treetino/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && bun run --parallel dev:compile dev:serve",
    "dev:compile": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:serve": "bun --watch dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test test",
    "db:generate": "bun --bun x drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@solana/web3.js": "^1.99.0",
    "@treetino/contracts": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
